# Copiar a ~/web-cv-secrets/contacto.env en el VPS con chmod 600.
# El email real del dueño y la API key SOLO viven aquí, nunca en el repo.
PORT=8081
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_TO=tucorreo@dominio.com
RESEND_FROM=contacto@joviur.dpdns.org
ASUNTO_DEFAULT=Contacto desde web-cv
# Orígenes permitidos (separados por coma). El visitante puede entrar por el
# dominio con o sin www: ambos se sirven por el mismo túnel, así que ambos
# orígenes deben estar listados o el fetch del formulario recibe 403.
ALLOWED_ORIGINS=https://joviur.dpdns.org,https://www.joviur.dpdns.org
RATE_LIMIT=5

---
import type { Experiencia } from '../types/cv'

interface Props {
  exp: Experiencia
}

const { exp } = Astro.props
---

<li data-reveal class="grid gap-1 border-b border-line py-4 sm:grid-cols-[150px_1fr] sm:gap-5">
  <!-- En móvil el puesto va primero (order-1); la fecha/empresa debajo (order-2) -->
  <div class="order-2 text-xs leading-relaxed text-muted sm:order-1">
    {exp.desde} — {exp.hasta}
    <br />
    {exp.empresa}
  </div>
  <div class="order-1 sm:order-2">
    <h3 class="text-[15px] font-bold">
      {exp.puesto}
      {
        exp.actual && (
          <span class="bg-phos px-1.5 py-0.5 align-middle text-[10px] font-medium text-base">
            ACTUAL
          </span>
        )
      }
    </h3>
    <ul class="mt-2 list-none">
      {
        exp.logros.map((l) => (
          <li class="py-0.5 text-sm leading-relaxed">
            <span class="text-phos" aria-hidden="true">» </span>
            {l}
          </li>
        ))
      }
    </ul>
  </div>
</li>

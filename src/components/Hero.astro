---
import { cv } from '../data/cv'

const actual = cv.experiencia.find((e) => e.actual) ?? cv.experiencia[0]
---

<section id="inicio" class="py-16">
  <p class="text-[13px] text-muted">
    <b class="font-medium text-phos">josema@dev</b>
    <span class="text-amber">:~</span>$ whoami
  </p>
  <h1 class="mt-5 text-[clamp(22px,6.5vw,46px)] font-bold leading-tight tracking-tight">
    {cv.nombre}
    <span
      class="cursor-blink ml-1 inline-block h-[1.05em] w-[11px] bg-phos align-[-2px]"
      aria-hidden="true"
    ></span>
  </h1>
  <p class="mt-3 text-[13px] font-medium text-phos">
    {cv.titulo} @ {actual.empresa}
  </p>
  <p class="mt-5 text-[13px] text-muted">
    <b class="font-medium text-phos">josema@dev</b>
    <span class="text-amber">:~</span>$ cat cv.txt
  </p>
  <p class="mt-3 max-w-[40em] text-sm leading-relaxed text-muted">
    {cv.resumen}
  </p>
</section>

---
import { cv } from '../data/cv'
import { t } from '../i18n/translations'
---

<footer id="contacto" class="mt-6 border-t border-line py-8 text-xs text-muted">
  <div class="mx-auto flex max-w-[780px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6">
    <a href={`mailto:${cv.email}`} class="text-phos transition-colors hover:underline">
      {cv.email}
    </a>
    <span class="flex flex-wrap items-center gap-x-2">
      <a href={`tel:${cv.telefono.replace(/\s/g, '')}`} class="text-phos transition-colors hover:underline">
        {cv.telefono}
      </a>
      <span aria-hidden="true">·</span>
      <span>{cv.ubicacion}</span>
    </span>
    <span>{cv.idiomas.map((i) => `${i.nombre} (${i.nivel})`).join(' · ')}</span>
  </div>
  <p class="mx-auto mt-6 max-w-[780px] px-6 text-[11px] text-muted">
    [ {t('footer.fin')} ]
  </p>
</footer>

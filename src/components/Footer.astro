---
import { cv } from '../data/cv'
import { t } from '../i18n/translations'
import ContactModal from './ContactModal.astro'
---

<footer id="contacto" data-tipeo-resto class="mt-6 border-t border-line py-8 text-xs text-muted">
  <div class="mx-auto flex max-w-[780px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6">
    <button
      data-contact-open
      class="flex items-center gap-1.5 border border-line px-2 py-0.5 text-[11px] text-muted transition-colors hover:border-phos hover:text-phos"
      aria-label={t('contacto.ariaAbrir')}
    >
      <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <rect x="2" y="3.5" width="12" height="9" rx="0.5"></rect>
        <path d="m2.5 4 5.5 4.5L13.5 4"></path>
      </svg>
      [{t('contacto.abrir')}]
    </button>
    <span>{cv.ubicacion}</span>
  </div>
  <p class="mx-auto mt-6 max-w-[780px] px-6 text-[11px] text-muted">
    [ {t('footer.fin')} ]
  </p>
  <ContactModal />
</footer>
